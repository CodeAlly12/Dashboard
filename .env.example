# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Channel Manager / OTA integrations
AIRBNB_API_KEY=
BOOKING_COM_API_KEY=
EXPEDIA_API_KEY=
VRBO_API_KEY=

# Messaging
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# North Star AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Booking assistant (HH Hospitality AI)
# ---------------------------------------------------------------------------
# Required for the assistant. Model + effort are optional overrides.
ANTHROPIC_MODEL=claude-opus-5
BOOKING_AI_EFFORT=medium

# Owner notifications / escalation (WhatsApp Business Cloud API).
# Without these, notifications are recorded in the audit log instead of sent.
OWNER_WHATSAPP_NUMBER=

# Shared secret for the calendar polling endpoint (POST /api/calendar/sync).
CRON_SECRET=

# Engine tuning — defaults shown.
BOOKING_TOOL_TIMEOUT_MS=3000
BOOKING_TOOL_RETRIES=2
BOOKING_TOOL_RETRY_DELAY_MS=500
BOOKING_CACHE_TTL_MS=30000
BOOKING_CALENDAR_STALE_MS=900000
BOOKING_HOLD_MINUTES=60
